# ============================================================
# Bajiman backend environment template
# Copy to .env locally, or add these values in the deployment dashboard.
# Never commit the real .env file or provider secrets.
# ============================================================

# ----------------------------
# Server and database
# ----------------------------
PORT=5000
VERCEL=0
MONGO_URI=mongodb+srv://DB_USER:DB_PASSWORD@DB_CLUSTER/DB_NAME
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRE=30d

# Public URLs. Both must use HTTPS in production.
PUBLIC_BACKEND_URL=https://api.example.com
PUBLIC_FRONTEND_URL=https://bajiman-client-one.vercel.app
BACKEND_URL=https://api.example.com

# Optional existing integration settings
MASTER_API_URL=https://master-api.example.com
JWT_TOKEN=
GAME_UID=

# ----------------------------
# World Casino catalog API
# ----------------------------
WORLD_CASINO_API_BASE=https://world-casino-api.com/api/v1
WORLD_CASINO_TOKEN=replace-with-world-casino-token
WORLD_CASINO_METHOD=GET
WORLD_CASINO_TOKEN_MODE=query
WORLD_CASINO_TOKEN_QUERY=token
WORLD_CASINO_TOKEN_HEADER=token
WORLD_CASINO_PROVIDERS_PATH=/providers
WORLD_CASINO_GAMES_PATH=/games

# Use 141 to import only 9Wicket. Leave empty to import the full catalog.
WORLD_CASINO_BRAND_ID=141
WORLD_CASINO_CATEGORY_ID=replace-with-local-mongodb-category-id
WORLD_CASINO_DRY_RUN=true
WORLD_CASINO_CONCURRENCY=3
WORLD_CASINO_PAGE_SIZE=100

# ----------------------------
# 9Wicket transfer-wallet API
# ----------------------------
# SoftAPI/IGAMING aliases are supported by the same AES-256-ECB adapter.
# Set SOFTAPI_LAUNCH_URL to the exact portal value shown as
# "Provided By IGAMING KEY"; do not guess this endpoint.
SOFTAPI_API_BASE=https://igamingapis.com
SOFTAPI_LAUNCH_URL=
SOFTAPI_TOKEN=
SOFTAPI_SECRET=
IGAMING_API_BASE=
IGAMING_LAUNCH_URL=
IGAMING_API_TOKEN=
IGAMING_API_SECRET=
WORLD_CASINO_API_BASE=https://world-casino-api.com/api/v1
NINEWICKET_TOKEN=replace-with-9wicket-token
# Must be exactly 32 UTF-8 bytes. Keep this server-side only.
NINEWICKET_SECRET=replace-with-exactly-32-character-secret
NINEWICKET_GAME_UID=11539
NINEWICKET_SYMBOL=9W
NINEWICKET_CURRENCY=BDT
NINEWICKET_LANGUAGE=en

# Provider callback and post-exit lobby URL.
# Callback must be public HTTPS. Return URL must not contain a query string.
NINEWICKET_CALLBACK_URL=https://api.example.com/api/9wicket/callback
NINEWICKET_RETURN_URL=https://bajiman-client-one.vercel.app/

# Fixed-egress relay. Set PROVIDER_* on Vercel and RELAY_* only on the
# fixed-egress relay host. Never commit real values.
PROVIDER_RELAY_URL=https://relay.example.com/api/provider-relay
PROVIDER_RELAY_KEY=replace-with-the-relay-shared-secret
RELAY_SHARED_SECRET=replace-with-a-long-random-relay-secret
# Alternative to the relay: a static outbound HTTP proxy.
OUTBOUND_PROXY_URL=

# ----------------------------
# Oracle catalog API (existing integration)
# ----------------------------
ORACLE_PROVIDER_LIST_API=https://oraclegames.net/api/providerlist
ORACLE_PROVIDER_LIST_KEY=replace-with-provider-list-key
ORACLE_GAME_DATA_KEY=replace-with-game-data-key
ORACLE_GAME_API_BASE=https://oraclegames.net/api/game
ORACLE_GAME_LAUNCH_URL=https://oraclegames.net/api/game/launch
ORACLE_LAUNCH_KEY=replace-with-oracle-launch-key
# Provider codes routed through the Oracle-compatible launch contract.
# WORLD_133 = KA, WORLD_92 = YGRGaming.
ORACLE_PROVIDER_CODES=WORLD_92,WORLD_133
ORACLE_WEBSITE_BASE=https://oraclegames.net
ORACLE_CATEGORY_ID=replace-with-local-mongodb-category-id
ORACLE_DRY_RUN=true
ORACLE_SYNC_CONCURRENCY=3

# ----------------------------
# Admin/API automation
# ----------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password
REQUIRE_DEPOSIT_SETUP=false

# ----------------------------
# Optional existing services
# ----------------------------
OTP_API_KEY=

# ----------------------------
# Local commands
# ----------------------------
# Crypto-only test:
# NINEWICKET_SECRET='your-32-byte-secret' node scripts/testNineWicketCrypto.js
#
# World Casino dry-run:
# WORLD_CASINO_DRY_RUN=true node scripts/syncWorldCasinoCatalog.js
#
# World Casino import:
# WORLD_CASINO_DRY_RUN=false node scripts/syncWorldCasinoCatalog.js
#
# Existing Oracle API sync dry-run:
# node scripts/syncOracleViaApi.js
