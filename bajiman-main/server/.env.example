# Oracle public/base URLs
ORACLE_WEBSITE_BASE=https://oraclegames.net
ORACLE_GAME_API_BASE=https://oraclegames.net/api/game
ORACLE_PROVIDER_LIST_API=https://oraclegames.net/api/provider
ORACLE_GAME_LAUNCH_URL=https://oraclegames.net/api/game/launch

# Secrets: set only in Vercel/server runtime or an untracked local .env
ORACLE_GAME_DATA_KEY=replace-with-oracle-data-key
ORACLE_LAUNCH_KEY=replace-with-oracle-launch-key
# Optional separate provider-list key; otherwise ORACLE_GAME_DATA_KEY is used.
ORACLE_PROVIDER_LIST_KEY=

# Smoke-test-only values; never commit these.
# BACKEND_URL=https://bajiman-server.vercel.app
# JWT_TOKEN=replace-with-user-jwt
# GAME_UID=replace-with-game-uid
